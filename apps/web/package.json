{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "tsx --env-file=.env scripts/build-static.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dup": "jscpd",
    "mutate": "stryker run",
    "etl": "tsx --env-file=.env scripts/etl/run.ts",
    "agent": "tsx --env-file=.env scripts/agent/cli.ts",
    "golden": "tsx --env-file=.env scripts/golden-urls.ts",
    "etl:verify": "tsx --env-file=.env scripts/etl/verify.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore-check": "tsx scripts/db-restore-check.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run dup"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jscpd": "^5.4.2",
    "mysql2": "^3.24.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
