# Generated by scripts/build-static.ts. Edit deploy/htaccess.template, not this file.
Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
__HEADERS__
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS only
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old WordPress URLs
RewriteRule ^feed/?$ /feed.xml [R=301,L]
RewriteRule ^(?:category|tag|author)/[^/]+/feed/?$ /feed.xml [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^blog/?$ /archive/ [R=301,L]
RewriteRule ^blog/page/([0-9]+)/?$ /archive/page/$1/ [R=301,L]
RewriteRule ^page/([0-9]+)/?$ /archive/page/$1/ [R=301,L]
RewriteRule ^author/ / [R=301,L]
__REDIRECTS__
</IfModule>

# Dotfiles, dumps, configs and sources never leave the server.
<FilesMatch "(^\.|\.(sql|bak|old|orig|log|ini|env|sh|md|ts|tsx|lock)$|~$)">
  Require all denied
</FilesMatch>

# The only PHP that may run is the contact form endpoint.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar)$">
  Require all denied
</FilesMatch>
<Files "send.php">
  Require all granted
</Files>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
