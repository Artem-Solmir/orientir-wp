generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  draft
  published
  archived
}

enum PageTemplate {
  default
  composer
}

model Post {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  // Sanitized HTML (DOMPurify on write, see Phase 2/5).
  body        String
  status      ContentStatus @default(draft)
  publishedAt DateTime?
  expiresAt   DateTime?
  views       Int           @default(0)
  seoTitle    String?
  seoDescription String?
  coverId     String?
  cover       MediaAsset?   @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  // Attribution for historical posts whose author is not migrated.
  authorName  String?
  legacyWpId  Int?          @unique
  categories  PostCategory[]
  tags        PostTag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  body        String
  template    PageTemplate  @default(default)
  status      ContentStatus @default(draft)
  seoTitle    String?
  seoDescription String?
  legacyWpId  Int?          @unique
  sections    PageSection[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PageSection {
  id      String @id @default(cuid())
  pageId  String
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  order   Int
  // featured_post_slider | latest | ... (validated by Zod discriminated union)
  type    String
  config  Json

  @@unique([pageId, order])
}

model Category {
  id         String         @id @default(cuid())
  slug       String         @unique
  name       String
  legacyWpId Int?           @unique
  posts      PostCategory[]
}

model Tag {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  legacyWpId Int?      @unique
  posts      PostTag[]
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model MediaAsset {
  id         String   @id @default(cuid())
  // Path relative to the media root, e.g. 2023/05/photo.jpg (no leading slash, no "..").
  path       String   @unique
  mimeType   String
  width      Int?
  height     Int?
  alt        String?
  // Resized copies next to the original: [{ file, width, height }], only those present on disk.
  variants   Json?
  legacyWpId Int?     @unique
  createdAt  DateTime @default(now())
  covers     Post[]   @relation("PostCover")
  galleryItems GalleryItem[]
}

model Gallery {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  status     ContentStatus @default(published)
  legacyWpId Int?          @unique
  items      GalleryItem[]
}

model GalleryItem {
  galleryId String
  mediaId   String
  order     Int
  gallery   Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([galleryId, mediaId])
}

model LegacyRedirect {
  fromPath String @id
  toPath   String
}

model AuditLog {
  id        String   @id @default(cuid())
  // "agent" for the service token.
  actorType String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model AdminOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
