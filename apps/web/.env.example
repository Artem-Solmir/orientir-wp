# Copy to .env and fill in. Never commit .env.

# Dev server URL (static build uses PUBLIC_SITE_URL, default https://orientir.by).
APP_URL=http://localhost:3000

# Dev: where to proxy /wp-content/uploads from (production uploads on the host).
MEDIA_DEV_ORIGIN=https://orientir.by

# Static production build
PUBLIC_SITE_URL=https://orientir.by

# Local admin at /admin (restart npm run dev). Disables static export in next.config.
ENABLE_ADMIN=1
ADMIN_PASSWORD=1111
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# FTP deploy (npm run deploy:ftp) — does not upload wp-content/
FTP_HOST=
FTP_USER=
FTP_PASS=
# activecloud: после входа вы уже в корне сайта — FTP_ROOT=/
FTP_ROOT=/
FTP_SECURE=0

# Optional: local folder when agent imports photos (npm run agent -- photos:import)
MEDIA_ROOT=../../wp-content/uploads
