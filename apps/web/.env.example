# Copy to .env and fill in. Never commit .env. All values are server-only.
POSTGRES_USER=orientir
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=orientir
DATABASE_URL=postgresql://orientir:change-me-long-random@127.0.0.1:5432/orientir?schema=public

# Dev-server address only; the static build fixes the public URL via PUBLIC_SITE_URL (default https://orientir.by).
APP_URL=http://localhost:3000

# Local admin at /admin (restart npm run dev after changing). Turns off static export in next.config.
ENABLE_ADMIN=1
ADMIN_PASSWORD=1111
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Legacy WordPress DB for the ETL (read-only use). Local XAMPP example; never commit real credentials.
WP_MYSQL_URL=mysql://user:password@127.0.0.1:3306/orientir
