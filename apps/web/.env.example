# Copy to .env and fill in. Never commit .env. All values are server-only.
POSTGRES_USER=orientir
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=orientir
DATABASE_URL=postgresql://orientir:change-me-long-random@127.0.0.1:5432/orientir?schema=public

# Auth.js JWT signing secret. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Bearer token for the AI agent (Agent API, Phase 5). Min 32 chars.
AGENT_API_TOKEN=

APP_URL=http://localhost:3000

# Legacy WordPress DB for the ETL (read-only use). Local XAMPP example; never commit real credentials.
WP_MYSQL_URL=mysql://user:password@127.0.0.1:3306/orientir
